; Exodus: Wilderness — Godot 4.7+
; Local split-screen and online sessions share one simulation.

config_version=5

[application]

config/name="Exodus: Wilderness"
config/description="Guide the camp of Israel across the Sinai. One to four players."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://autoload/event_bus.gd"
NetworkManager="*res://autoload/network_manager.gd"
SessionManager="*res://autoload/session_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="landscape"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="leaders"
3d_physics/layer_3="enemies"

[physics]

3d/default_gravity=0.0

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
renderer/rendering_method.web="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.55, 0.4, 0.24, 1)
